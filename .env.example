# ============================================================================
# 环境变量模板
#
# 复制本文件为 .env 后即可使用：cp .env.example .env
# （.env 已被 .gitignore 忽略，不会提交到仓库；本文件会提交）
#
# 【本文件为什么必须一直准确】
# 它是「这个项目需要配哪些变量」的唯一说明。漏掉一个变量的后果是
# 别人 clone 下来按说明配完，跑起来却在某个角落报错 —— 而且报错点
# 通常离「少配了一个环境变量」很远。所以每加一个变量都要回来补一行。
# ============================================================================

# ---- 数据库 ----
#
# PostgreSQL 连接串。本地开发用的是 shopdev 这个库。
#
# 【<密码> 换成什么】
# 换成你安装 PostgreSQL 时给 postgres 超级用户设的那个密码。
# 找不到了的话：pgAdmin 里可以重置，或者告诉我，我给你一条命令。
#
# 【密码里有特殊字符（@ : / # ?）怎么办】
# 必须做百分号编码，否则会被当成连接串的语法。
# 比如密码是 p@ss 就写成 p%40ss。
# 例：密码 p@ss:1  →  postgresql://postgres:p%40ss%3A1@localhost:5432/shopdev
#
# 【另外两个库不用在这里配】
# 集成测试用 shoptest、E2E 用 shope2e。它们是脚本把下面这行连接串的
# 库名换掉得到的（见 scripts/db-url.mjs 的 urlForDatabase）——
# 这样密码只有这一处，不会在三个地方各存一份、然后有一处忘了改。
# 建这三个库：npm run db:create
DATABASE_URL="postgresql://postgres:<密码>@localhost:5432/shopdev"

# ---- 数据库（仅生产需要）----
#
# Neon 的**直连**地址，只给迁移用（prisma migrate deploy）。
#
# 【为什么需要它：替代了老版本的 directUrl】
# 生产环境的 DATABASE_URL 填的是 Neon 的**池化**地址（pgbouncer），
# 因为 serverless 上会开很多短连接。但迁移用不了池化连接 ——
# 池化不支持迁移要用的会话级特性。所以迁移走直连。
# Prisma 7 取消了 schema.prisma 里的 directUrl，改由
# prisma7.config.ts 读 `DIRECT_URL || DATABASE_URL`。
#
# 【本地开发不要配这一行】
# 本地没有池化这回事，配了反而多一处可能写错的地方 ——
# 空着就会自动退回用 DATABASE_URL。
# 只有部到 Vercel 时才需要把它设成 Neon 的直连串。
# DIRECT_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# ---- 种子数据 ----
#
# 要不要种那两个演示账号（admin@shop.dev / admin123、user@shop.dev / user123）。
#
# 【默认不用配】默认行为是**按连接串判断**：DATABASE_URL 指向本机
# （localhost / 127.0.0.1）就种，指向远程（比如 Neon）就跳过。
# 所以线上什么都不用做，那两个弱密码账号不会出现。
#
# 【什么时候需要写这一行】
# 只有在你想推翻默认判断的时候 —— 比如 CI 上连的是远程测试库、
# 但确实需要这两个账号，就设成 true：
# SEED_DEMO_USERS="true"
# 反过来，本地想验证「线上那种空用户表」的样子，就设成 false：
# SEED_DEMO_USERS="false"

# ---- 认证 ----
#
# 签发/校验登录 JWT 的密钥。生产环境**必须**是独立生成的新值，
# 不要复用本地这一个 —— 复用等于把生产的会话签发权交出去了。
# 生成一个随机密钥：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-random-32-byte-hex-string"

# ---- 业务配置 ----
# 订单超时未支付自动取消的分钟数。
# 想快速验证自动取消，把它改成 1，下单后等 1 分钟再刷订单页即可
ORDER_TIMEOUT_MINUTES="15"

# ---- 定时任务 ----
# 每次请求 /api/cron/expire-orders 都要带这个密钥（Authorization: Bearer <值>）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET="replace-with-a-random-secret"

# 本地跑 scripts/cron-dev.mjs 的开关。默认关着，
# 免得在你没注意的时候后台一直改数据
CRON_ENABLED="false"

# ---- 支付（Stripe）----
# 服务端建 PaymentIntent / 验签 webhook 用的密钥。去 Stripe 控制台拿 sk_test_ 开头的测试密钥。
# 绝对不能提交进代码库、也绝不能写进命令行参数 —— 只走 .env。
STRIPE_SECRET_KEY="sk_test_xxx"

# 前端渲染收银台用的 publishable key（pk_test_ 开头）。NEXT_PUBLIC_ 前缀会让它
# 在构建时被内联进客户端 bundle，所以这个值**不敏感**，但本文件里占个位置
# 说明「项目需要它」。
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# 验签 webhook 请求的密钥。本地跑 `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# 时，Stripe CLI 会打印一个 whsec_ 开头的值，把它填到这里。
STRIPE_WEBHOOK_SECRET="whsec_xxx"
